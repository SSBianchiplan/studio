{
  "name": "GPlanSiS|Studio",
  "short_name": "Studio",
  "description": "Edição de imagem, ilustração vetorial e revelação de fotos no navegador.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "lang": "pt-BR",
  "dir": "ltr",
  "background_color": "#15181b",
  "theme_color": "#1f2428",
  "categories": [
    "photo",
    "graphics",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".avif",
          ".gif",
          ".bmp",
          ".svg",
          ".heic",
          ".heif",
          ".jxl",
          ".tif",
          ".tiff",
          ".tga",
          ".qoi",
          ".ico"
        ],
        "image/vnd.adobe.photoshop": [
          ".psd"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Projetos",
      "url": "/",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}