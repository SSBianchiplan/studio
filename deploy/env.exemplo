# /opt/gplansis-studio/.env — criado pelo enviar.sh no primeiro deploy (permissão 600).
STUDIO_DATA=/opt/gplansis-studio/dados
STUDIO_WEB=/opt/gplansis-studio/web
STUDIO_MASTER_EMAIL=contato@gplansis.com
STUDIO_COOKIE_SECURE=1
# Sem STUDIO_MASTER_PASSWORD, o primeiro arranque gera uma senha aleatória em
# /opt/gplansis-studio/dados/senha-inicial-master.txt (troca obrigatória no 1º acesso).
