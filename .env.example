# Variáveis do servidor do GPlanSiS|Studio (server/app.py).
# Copie para .env e ajuste. Valores abaixo são fictícios, para rodar localmente.
# Em produção o arquivo fica em /opt/gplansis-studio/.env (permissão 600) — ver deploy/env.exemplo.

# pasta de dados: banco SQLite e projetos salvos na nuvem
STUDIO_DATA=./dados
# pasta dos estáticos gerados pelo build (python3 build.py)
STUDIO_WEB=./dist/web
# e-mail do administrador master (não pode ser excluído nem rebaixado)
STUDIO_MASTER_EMAIL=admin@exemplo.com
# senha inicial do master, usada só no primeiro arranque (troca obrigatória no 1º acesso).
# Deixe vazio para o servidor gerar uma aleatória em $STUDIO_DATA/senha-inicial-master.txt
STUDIO_MASTER_PASSWORD=Troque-Esta-Senha-123
# 1 em produção (HTTPS); 0 para testar em http://127.0.0.1
STUDIO_COOKIE_SECURE=0
